# OS
.DS_Store
Thumbs.db
.idea/

# Internal working notes — local only, not for the repo.
# docs/ IS tracked: it holds the three documents that ship with a release
# (ARCHITECTURE.md, DIAGNOSTICS.md, MODDING_GUIDE.md). Everything else --
# scopes, plans, audits, investigation write-ups -- lives in devdocs/.
devdocs/

# Session build/scratch artifacts
build_x64/
__pycache__/
.allyrc

# Runtime output written at the process CWD.
# dump/ is gdx_dump_launch's asset dump (wav/json/tsv), rebuilt from the user's
# ROM. *.log was already ignored, but the logs/ directory itself was not.
dump/
logs/

# Internal one-off investigation toolkits and their output. Not needed to build,
# extract assets, or mod -- ek_recovery/ is a manually-invoked 64DD disk-forensics
# kit whose conclusions are already baked into tools/gen_translated_ek_table.py,
# and ek_translated_validate/ is just the PNG renders it emits for eyeballing.
/tools/ek_recovery/
/tools/ek_translated_validate/
# o2r_harness scratch: whole extraction runs written side by side for comparison.
# Regenerated from the user's ROM by the harness itself; never a repo input.
/tools/o2r_harness/bless_out/
/tools/o2r_harness/golden_out/